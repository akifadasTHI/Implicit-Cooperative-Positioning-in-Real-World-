#!/usr/local/bin/gnuplot
set term wxt size 1400,800
set termoption noenhanced
set size 1,1
set title 'Used Satellites' font ',18'
set xlabel 'GPS TOW [s]' font ',13'
set ylabel 'Used Satellites' font ',13'
set grid
set mxtics 5
set ytics 1
set yrange [0:30.5]
set label 'Position Mode' at graph 0.03, graph 0.16 front
set arrow from graph 0.03, graph 0.14 to graph 0.06, graph 0.14 nohead lc 'red' front
set arrow from graph 0.03, graph 0.12 to graph 0.06, graph 0.12 nohead lc 'purple' front
set arrow from graph 0.03, graph 0.10 to graph 0.06, graph 0.10 nohead lc 'cyan' front
set arrow from graph 0.03, graph 0.08 to graph 0.06, graph 0.08 nohead lc 'blue' front
set arrow from graph 0.03, graph 0.06 to graph 0.06, graph 0.06 nohead lc 'green' front
set arrow from graph 0.03, graph 0.04 to graph 0.06, graph 0.04 nohead lc 'black' front
set label 'SPS' at graph 0.065, graph 0.14 front
set label 'SBAS' at graph 0.065, graph 0.12 front
set label 'DGPS' at graph 0.065, graph 0.10 front
set label 'RTK Float' at graph 0.065, graph 0.08 front
set label 'RTK Fixed' at graph 0.065, graph 0.06 front
set label 'DR' at graph 0.065, graph 0.04 front
set key off
set label 'File: .\swift-gnss-20231221-133827.sbp.json' at graph 0, graph -0.06
plot '-' u 1:2:3 title 'Position Mode' with lines lw 1 lc rgb var
