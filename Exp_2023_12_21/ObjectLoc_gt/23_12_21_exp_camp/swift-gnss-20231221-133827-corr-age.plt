#!/usr/local/bin/gnuplot
set term wxt size 1400,800
set termoption noenhanced
set size 1,1
set title 'GNSS Corrections Age' font ',18'
set xlabel 'GPS TOW [s]' font ',13'
set ylabel 'GNSS Corrections Age [s]' font ',13'
set grid
set mxtics 5
set mytics 5
set label 'Position Mode' at graph 0.03, graph 0.96 front
set arrow from graph 0.03, graph 0.94 to graph 0.06, graph 0.94 nohead lc 'cyan' front
set arrow from graph 0.03, graph 0.92 to graph 0.06, graph 0.92 nohead lc 'blue' front
set arrow from graph 0.03, graph 0.90 to graph 0.06, graph 0.90 nohead lc 'green' front
set label 'DGPS' at graph 0.065, graph 0.94 front
set label 'RTK Float' at graph 0.065, graph 0.92 front
set label 'RTK Fixed' at graph 0.065, graph 0.90 front
set key off
set label 'File: .\swift-gnss-20231221-133827.sbp.json' at graph 0, graph -0.06
plot '-' u 1:2:3 title 'Position Mode' with lines lc rgb var
