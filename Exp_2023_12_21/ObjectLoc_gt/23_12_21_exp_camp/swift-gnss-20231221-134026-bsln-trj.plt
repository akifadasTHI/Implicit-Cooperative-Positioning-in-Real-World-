#!/usr/local/bin/gnuplot
set term wxt size 1000, 800
set termoption noenhanced
set size ratio -1
set title 'RTK Baseline Trajectory' font ',18'
set xlabel 'West - East [m]' font ',13'
set ylabel 'South - North [m]' font ',13'
set grid
set mxtics 5
set mytics 5
#set xrange [-5:5]
#set yrange [-5:5]
set label 'Base' front center at 0,0 offset 0,0.8
set label 'Position Mode' at graph 0.03, graph 0.08 front
set arrow from graph 0.03, graph 0.06 to graph 0.06, graph 0.06 nohead lc 'blue' front
set arrow from graph 0.03, graph 0.04 to graph 0.06, graph 0.04 nohead lc 'green' front
set label 'RTK Float' at graph 0.065, graph 0.06 front
set label 'RTK Fixed' at graph 0.065, graph 0.04 front
set key off
set label 'File: .\swift-gnss-20231221-134026.sbp.json' at graph 0, graph -0.06
plot '-' title 'Base' with points pt 1 ps 2 lc 'red', \
     '-' title 'Baseline Mode' with lines lc rgb var
0 0
e
